# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# ---- Airflow core ----
AIRFLOW_UID=50000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---- Airflow metadata database (Postgres) ----
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# ---- MySQL staging layer ----
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=staging
MYSQL_USER=staging_loader
MYSQL_PASSWORD=change_me

# ---- PostgreSQL analytics layer (least-privilege user, separate from Airflow's own DB) ----
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change_me
ANALYTICS_DB_NAME=flight_analytics
ANALYTICS_DB_USER=analytics_writer
ANALYTICS_DB_PASSWORD=change_me
